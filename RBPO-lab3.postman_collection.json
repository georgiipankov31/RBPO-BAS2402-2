              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/api/housing-applications/{{demo_applicationId}}",
                "description": "204."
              }
            },
            {
              "name": "29. Удалить отмененную заявку на проживание",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": "{{baseUrl}}/api/housing-applications/{{demo_cancelApplicationId}}",
                "description": "204."
              }
            },
            {
              "name": "30. Удалить свободную комнату А",
              "request": {
                "method": "DELETE",
