  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01. Создать жильца\") {",
          "    pm.collectionVariables.set(\"runId\", String(Date.now()));",
          "    const now = new Date();",
          "    const until = new Date(now);",
          "    until.setDate(until.getDate() + 30);",
          "    const extended = new Date(now);",
          "    extended.setDate(extended.getDate() + 60);",
          "    pm.collectionVariables.set(\"today\", now.toLocaleDateString(\"en-CA\", {timeZone: \"Europe/Moscow\"}));",
          "    pm.collectionVariables.set(\"until\", until.toLocaleDateString(\"en-CA\", {timeZone: \"Europe/Moscow\"}));",
          "    pm.collectionVariables.set(\"extended\", extended.toLocaleDateString(\"en-CA\", {timeZone: \"Europe/Moscow\"}));",
          "}"
        ]
      }
    }
