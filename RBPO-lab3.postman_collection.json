  "item": [
    {
      "name": "0. Полный сценарий",
      "description": "Выполняйте запросы по порядку с 01. При новом запуске создается уникальный постфикс. ID и даты заполняются автоматически. Папку 7 можно пропустить, чтобы оставить данные в БД.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.requestName === \"01. Создать пользователя\") {",
              "    const keys = [\"demo_runId\",\"demo_today\",\"demo_until\",\"demo_extended\",\"demo_userId\",\"demo_roomAId\",\"demo_roomBId\",\"demo_cancelApplicationId\",\"demo_applicationId\",\"demo_contractId\",\"demo_transferId\",\"demo_pendingTransferId\"];",
              "    for (const key of keys) {",
              "        pm.collectionVariables.set(key, \"\");",
              "    }",
              "    pm.collectionVariables.set(\"demo_runId\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "    const today = new Date();",
              "    const until = new Date(today);",
              "    until.setDate(until.getDate() + 30);",
              "    const extended = new Date(today);",
              "    extended.setDate(extended.getDate() + 60);",
              "    pm.collectionVariables.set(\"demo_today\", today.toLocaleDateString(\"en-CA\", {timeZone: \"Europe/Moscow\"}));",
              "    pm.collectionVariables.set(\"demo_until\", until.toLocaleDateString(\"en-CA\", {timeZone: \"Europe/Moscow\"}));",
              "    pm.collectionVariables.set(\"demo_extended\", extended.toLocaleDateString(\"en-CA\", {timeZone: \"Europe/Moscow\"}));",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "1. Создать пользователя и комнаты",
          "item": [
            {
              "name": "01. Создать пользователя",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/users",
                "description": "201. Имя с уникальным постфиксом. ID сохраняется из ответа.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Аня {{demo_runId}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "    pm.collectionVariables.set(\"demo_userId\", pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "02. Создать комнату А",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/rooms",
                "description": "201. Свободная комната на одного жильца; номер уникален для этого запуска.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"number\": \"A-{{demo_runId}}\",\n  \"capacity\": 1,\n  \"available\": true\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "    pm.collectionVariables.set(\"demo_roomAId\", pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "03. Создать комнату Б",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/rooms",
                "description": "201. Вторая свободная комната для переселения.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"number\": \"B-{{demo_runId}}\",\n  \"capacity\": 1,\n  \"available\": true\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "    pm.collectionVariables.set(\"demo_roomBId\", pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "2. Подать и отменить заявку",
          "item": [
            {
              "name": "04. Подать заявку для отмены",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/housing-applications",
                "description": "201. Заявка относится к пользователю этого запуска.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"userId\": {{demo_userId}},\n  \"status\": \"NEW\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "    pm.collectionVariables.set(\"demo_cancelApplicationId\", pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "05. Отменить заявку",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/api/housing-applications/{{demo_cancelApplicationId}}/cancel",
                "description": "200. В ответе status = CANCELLED."
              }
            },
            {
              "name": "06. Посмотреть отмененную заявку",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/housing-applications/{{demo_cancelApplicationId}}",
                "description": "200. Заявка сохранилась в БД со статусом CANCELLED."
              }
            },
            {
              "name": "07. Заселить по отмененной заявке: ожидается 409",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/housing-applications/{{demo_cancelApplicationId}}/settle",
                "description": "409. Отмененная заявка не позволяет создать договор.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"roomId\": {{demo_roomAId}},\n  \"checkOutDate\": \"{{demo_until}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "name": "3. Подать новую заявку и заселиться",
          "item": [
            {
              "name": "08. Подать новую заявку на проживание",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/housing-applications",
                "description": "201. Новая заявка того же пользователя, status = NEW.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"userId\": {{demo_userId}},\n  \"status\": \"NEW\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "    pm.collectionVariables.set(\"demo_applicationId\", pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "09. Заселить в комнату А",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/housing-applications/{{demo_applicationId}}/settle",
                "description": "200. Создается договор ACTIVE; дата заселения сегодняшняя, дата окончания через 30 дней. ID договора сохраняется автоматически.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"roomId\": {{demo_roomAId}},\n  \"checkOutDate\": \"{{demo_until}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "    pm.collectionVariables.set(\"demo_contractId\", pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "10. Посмотреть одобренную заявку",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/housing-applications/{{demo_applicationId}}",
                "description": "200. status = APPROVED: заселение изменило исходную заявку."
              }
            },
            {
              "name": "11. Посмотреть действующий договор",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/residence-contracts/{{demo_contractId}}",
                "description": "200. status = ACTIVE, roomId соответствует комнате А."
              }
            },
            {
              "name": "12. Заселиться повторно: ожидается 409",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/housing-applications/{{demo_applicationId}}/settle",
                "description": "409. Повторное заселение по уже обработанной заявке запрещено.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"roomId\": {{demo_roomAId}},\n  \"checkOutDate\": \"{{demo_until}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "name": "4. Продлить проживание",
          "item": [
            {
              "name": "13. Продлить проживание до 60 дней",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/residence-contracts/{{demo_contractId}}/extend",
                "description": "200. checkOutDate становится на 30 дней позже прежней даты.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"checkOutDate\": \"{{demo_extended}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "14. Посмотреть новую дату окончания",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/residence-contracts/{{demo_contractId}}",
                "description": "200. Договор ACTIVE, checkOutDate соответствует новой дате."
              }
            }
          ]
        },
        {
          "name": "5. Переселиться из А в Б",
          "item": [
            {
              "name": "15. Подать заявку на переселение в Б",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/room-transfer-requests",
                "description": "201. Заявка NEW связывает текущий договор с комнатой Б.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"contractId\": {{demo_contractId}},\n  \"targetRoomId\": {{demo_roomBId}},\n  \"status\": \"NEW\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "    pm.collectionVariables.set(\"demo_transferId\", pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "16. Подтвердить переселение",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/api/room-transfer-requests/{{demo_transferId}}/approve",
                "description": "200. Заявка становится APPROVED, в договоре меняется roomId."
              }
            },
            {
              "name": "17. Посмотреть договор после переселения",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/residence-contracts/{{demo_contractId}}",
                "description": "200. roomId теперь соответствует комнате Б, договор остается ACTIVE."
              }
            },
            {
              "name": "18. Посмотреть выполненную заявку на переселение",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/room-transfer-requests/{{demo_transferId}}",
                "description": "200. status = APPROVED."
              }
            }
          ]
        },
        {
          "name": "6. Выселиться и проверить связанные записи",
          "item": [
            {
              "name": "19. Подать еще одну заявку на переселение в А",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/room-transfer-requests",
                "description": "201. Заявка остается NEW и отменяется при выселении.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"contractId\": {{demo_contractId}},\n  \"targetRoomId\": {{demo_roomAId}},\n  \"status\": \"NEW\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code >= 200 && pm.response.code < 300) {",
                      "    pm.collectionVariables.set(\"demo_pendingTransferId\", pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "20. Выселить жильца",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/api/residence-contracts/{{demo_contractId}}/check-out",
                "description": "200. Договор завершается, дата выезда становится сегодняшней; исходная заявка завершается, необработанное переселение отменяется."
              }
            },
            {
              "name": "21. Посмотреть завершенный договор",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/residence-contracts/{{demo_contractId}}",
                "description": "200. status = COMPLETED, checkOutDate = сегодня."
              }
            },
            {
              "name": "22. Посмотреть завершенную заявку на проживание",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/housing-applications/{{demo_applicationId}}",
                "description": "200. status = COMPLETED."
              }
            },
            {
              "name": "23. Посмотреть автоматически отмененное переселение",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/api/room-transfer-requests/{{demo_pendingTransferId}}",
                "description": "200. status = CANCELLED."
              }
            },
            {
              "name": "24. Выселить повторно: ожидается 409",
              "request": {
                "method": "POST",
                "header": [],
                "url": "{{baseUrl}}/api/residence-contracts/{{demo_contractId}}/check-out",
                "description": "409. Договор уже завершен."
              }
            }
          ]
        },
        {
          "name": "7. Удаление данных (необязательно)",
          "item": [
            {
              "name": "25. Удалить отмененную заявку на переселение",
              "request": {
