      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/refresh",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "От чьего лица: Клиент без Bearer-авторизации.\n\nPOST /auth/refresh\n\nОжидаемый HTTP-код: 401.\n\nСессия уже REVOKED. Пара не выдается, количество строк не меняется.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{jwtOldRefresh}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "20. Аня, новый access после отказа старому refresh (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtAccess}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "description": "От чьего лица: Аня с ролью USER, Bearer-токен.\n\nGET /api/me\n\nОжидаемый HTTP-код: 200.\n\nНовая пара не отзывается вместе со старым refresh. Немедленный отзыв access заданием не требуется."
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01. Зарегистрировать Аню и получить пару (201)\") {",
          "    const id = pm.variables.replaceIn(\"{{$guid}}\");",
          "    for (const key of [\"jwtRegistrationAccess\", \"jwtRegistrationRefresh\", \"jwtAccess\", \"jwtRefresh\", \"jwtOldAccess\", \"jwtOldRefresh\"]) {",
          "        pm.collectionVariables.set(key, \"\");",
          "    }",
          "    pm.collectionVariables.set(\"jwtRunId\", id);",
          "    pm.collectionVariables.set(\"jwtEmail\", \"anya-\" + id + \"@example.test\");",
          "    pm.collectionVariables.set(\"jwtPassword\", \"Aa!7\" + id);",
          "    pm.collectionVariables.set(\"jwtRegistrationDeviceId\", \"register-\" + id);",
          "    pm.collectionVariables.set(\"jwtLoginDeviceId\", \"login-\" + id);",
          "}",
          "for (const [key, value] of Object.entries(pm.collectionVariables.toObject())) {",
          "    pm.variables.set(key, value);",
          "}",
          "if (!pm.collectionVariables.get(\"jwtRunId\")) {",
          "    pm.execution.skipRequest();",
          "    throw new Error(\"Начните с первого запроса коллекции.\");",
          "}",
          "const requestTemplate = pm.request.url.toString() + \"\\n\" + (pm.request.body && pm.request.body.raw || \"\") + \"\\n\" + JSON.stringify(pm.request.auth);",
          "for (const match of requestTemplate.matchAll(/{{(jwt[A-Za-z]+)}}/g)) {",
          "    if (!pm.collectionVariables.get(match[1])) {",
          "        pm.execution.skipRequest();",
          "        throw new Error(\"Выполните предыдущие запросы коллекции. Не заполнено \" + match[1]);",
          "    }",
          "}"
        ]
      }
    }
  ]
}
