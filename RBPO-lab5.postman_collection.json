        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "От чьего лица: Клиент без Bearer-авторизации.\n\nPOST /auth/refresh\n\nОжидаемый HTTP-код: 401.\n\nОбновление принимает только JWT с type=refresh. Записей в БД не добавляется.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{jwtAccess}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
